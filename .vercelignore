# Mirrors .gitignore's data-pipeline exclusions so `vercel deploy` doesn't
# try to upload the multi-GB outputs/inputs/dados working directories --
# only the small tracked exception files below are needed at build/runtime.

node_modules
.next

__pycache__
*.py[cod]
.venv
venv
env
.pytest_cache

.artifact_work
.codex_spreadsheet_work
.agents
.codex
.git.onedrive-placeholder

outputs/*
dashboard/__pycache__
dashboard/data.json
dashboard/*.parquet
dados/cache/*
dados/processados
inputs/official/*
*.parquet

!outputs/official_2026_rais
outputs/official_2026_rais/*
!outputs/official_2026_rais/fact_employment_rais.csv
!outputs/tsb_bridge_2026
!dados/cache/ncm_vigente.json
!dados/cache/dim_pais_comex.csv
!dados/cache/dim_municipio_ibge.csv

!inputs/official
!inputs/official/BEN2026_Capitulo2_Oferta_Demanda_por_Fonte.xlsx
!inputs/official/BEN2026_Capitulo3_Consumo_Energia_por_Setor.xlsx

.env
.env.local
.env.*.local

.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.log
