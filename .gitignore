# Dependencies
node_modules/
.next/

# Python caches and local environments
__pycache__/
*.py[cod]
.venv/
venv/
env/
.venv-fastapi/
.pytest_cache/

# Codex and local working artifacts
.artifact_work/
.codex_spreadsheet_work/
.agents/
.codex/
.git.onedrive-placeholder/

# Generated outputs
outputs/*
dashboard/__pycache__/
dashboard/data.json
dashboard/*.parquet
dados/cache/*
dados/processados/
inputs/official/
*.parquet

# Exceções: snapshot derivado de RAIS/território exigido pelo botão de
# atualização do Painel Admin (build_solar_sovereignty_metrics.py e afins) --
# fica desatualizado só quando a RAIS for reprocessada manualmente (ver
# docs/DEPLOY.md, Secao 4). Agregado por UF/municipio/CNAE, sem microdado
# individual.
!outputs/official_2026_rais/
outputs/official_2026_rais/*
!outputs/official_2026_rais/fact_employment_rais.csv
!outputs/tsb_bridge_2026/
!dados/cache/ncm_vigente.json
!dados/cache/dim_pais_comex.csv

# Excecao: tabela estatica de priorizacao por especialistas (CNAE), exigida
# pelo botao de atualizacao do Painel Admin (build_final_border_value_outputs.py)
# -- nunca gerada por script, so lida; sem essa excecao o passo "Producao
# industrial consolidada" falha com FileNotFoundError em qualquer deploy novo
# da Railway (outputs/* nunca chega la sem excecao explicita).
!outputs/official_2026/
outputs/official_2026/*
!outputs/official_2026/priorizacao_especialistas_cnae.csv
!dados/cache/dim_municipio_ibge.csv

# Excecao: workbooks-fonte do BEN (EPE), exigidos pelo botao de atualizacao
# do Painel Admin (build_energy_context_ben.py) -- sem logica de download,
# le direto desses arquivos. Ficam desatualizados so quando o BEN publicar
# novo ano-base (ver docs/DEPLOY.md, Secao 4, e project memory sobre BEN/EPE).
# (a pasta inteira precisa ser reaberta antes de negar arquivos especificos --
# git nao desce em diretorios ja ignorados por regra de diretorio.)
!inputs/official/
inputs/official/*
!inputs/official/BEN2026_Capitulo2_Oferta_Demanda_por_Fonte.xlsx
!inputs/official/BEN2026_Capitulo3_Consumo_Energia_por_Setor.xlsx

# Local secrets (ADMIN_PASSWORD, ADMIN_TRIGGER_SECRET, etc.)
.env
.env.local
.env.*.local

